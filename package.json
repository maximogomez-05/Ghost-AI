{
  "name": "ghost-ai",
  "version": "1.0.0",
  "description": "App de IA en Windows",
  "author": "Ariel Espinoza (edit: Máximo Gómez)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis"
  },
  "dependencies": {
    "marked": "^18.1.2",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.ghostai.assistant",
    "productName": "Ghost AI",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "antigravity-bridge.js",
      "marked.min.js",
      "public/**/*",
      "solvers/**/*",
      "copier.exe"
    ],
    "extraResources": [
      "copier.exe"
    ],
    "asar": true,
    "asarUnpack": [
      "copier.exe"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ghost AI"
    }
  }
}
